{
  "manifest_version": 3,
  "name": "shizue sign-in helper",
  "description": "Completes Sign in with ChatGPT for the shizue web app.",
  "version": "0.1.0",
  "key": "",
  "permissions": [
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*"
    ]
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "callback",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
