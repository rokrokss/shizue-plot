    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.23.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
