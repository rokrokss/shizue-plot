DATABASE_URL=postgres://plot:plot@localhost:15433/plot
# Scratch database for `pnpm test` — every table in it is TRUNCATEd before each
# test. Required, must differ from DATABASE_URL, must not carry a `database`
# query parameter, and the name must end in `_test`. Create and migrate it once
# (the migration target is DATABASE_URL, so it is spelled out — your shell does
# not read this file):
#   docker compose exec -T postgres psql -U plot -d plot -c "CREATE DATABASE plot_test"
#   DATABASE_URL=postgres://plot:plot@localhost:15433/plot_test pnpm db:migrate
TEST_DATABASE_URL=postgres://plot:plot@localhost:15433/plot_test
# The web app's origin (scheme://host[:port], no path). Writes must come from it
# and Sign in with ChatGPT returns to it. The name is kept from the earlier
# auth library.
BETTER_AUTH_URL=http://localhost:13000
# Seals every reader's ChatGPT tokens in the database and derives this server's
# OpenAI host ID. Optional while BETTER_AUTH_URL is this machine's (a fixed dev
# value is used); with any other origin, or NODE_ENV=production, the API refuses
# to start without one of at least 32 characters (openssl rand -base64 32).
# Changing it signs everyone out.
# BETTER_AUTH_SECRET=
API_PORT=8787
# Where the API listens. Loopback when it runs beside the web app; 0.0.0.0 when
# it runs on a server of its own (point the web app's API_ORIGIN at it).
# API_HOST=127.0.0.1
# How the API's log reads: text (the default) is the console as a terminal shows
# it; json, for production, makes every line one JSON object
# {time, level, msg, component?, requestId?, err?} and adds an access line per
# request.
# LOG_FORMAT=text
# Prometheus metrics on a listener of their own, never under /api. Unset is off.
# METRICS_HOST stays on loopback unless the scraper runs on another machine.
# `embedder:serve` reads them too; give it a port of its own beside an API.
# METRICS_PORT=9464
# METRICS_HOST=127.0.0.1
# How long a shutdown waits for background work the turns started (summaries,
# relationships, vectors) after it has stopped the open replies, in ms.
# SHUTDOWN_BACKGROUND_MS=20000
# Object storage — avatars, character assets, covers and chat attachments
# all live behind one driver, chosen once at boot.
#   local (or unset) — files under UPLOAD_DIR, laid out avatars/ assets/ covers/ attachments/
#   s3               — anything that speaks S3: real S3, or the RustFS in
#                      docker-compose.yml
STORAGE_DRIVER=local
# Local driver root, resolved from the repo root. Holds all image namespaces.
UPLOAD_DIR=./data/uploads
# S3 driver, read when STORAGE_DRIVER=s3; the values below are the RustFS in docker-compose.yml.
# `embedder:fetch` and `embedder:publish` read them whatever the driver: KURE-v1's
# weights live in this bucket under models/.
S3_BUCKET=shizue-media
S3_REGION=us-east-1
# The service endpoint. Leave empty on real AWS S3 — the SDK picks the regional one.
S3_ENDPOINT=http://localhost:19000
# Leave both empty on AWS to use the SDK's provider chain (instance role, AWS_*).
S3_ACCESS_KEY_ID=shizue
S3_SECRET_ACCESS_KEY=shizue-secret
# bucket/key in the path instead of bucket. in the hostname. A local store needs it
# (a virtual-hosted bucket cannot resolve as a subdomain of localhost); AWS does not.
S3_FORCE_PATH_STYLE=true
# A card or module import is uploaded by the reader's browser straight into the
# bucket, at presigned addresses (ARCHITECTURE §10 파일 임포트). The bucket needs
# CORS for PUT from the web origin, and a lifecycle rule that expires imports/
# (docker-compose.yml's s3-init sets both on the RustFS). Set this only where the
# API reaches the store at an address browsers cannot: the presigned addresses
# are written with it.
# S3_PUBLIC_ENDPOINT=https://media.example.com
# File imports this API process reads at once, each on a job loop of its own:
# what bounds the memory imports take (a few 8MB parts and a card's text each).
# IMPORT_WORKERS=2
# Sign in with ChatGPT is the only login and AI connection; no API key is used.
# OpenAI returns to http://127.0.0.1:<this port>/auth/callback, and the
# Shizue extension (Chrome Web Store, 0.3.6+) rewrites that to this app's
# /api/chatgpt/callback. Its rules give each web origin its own port — 47801 for
# http://localhost:13000 and 47811 for https://plot.shizue.net — and the API
# picks those itself from BETTER_AUTH_URL. Set it only for another origin, with an
# extension of its own; production refuses a port that disagrees with Shizue.
# CHATGPT_CALLBACK_PORT=47801
# Running shizue on your own computer only (the hosted service has none of this):
# other origins the same web app is reached at, comma-separated — a tunnel to
# this machine, so a phone can open it (e.g. `tailscale serve --https=8444 --bg
# http://127.0.0.1:13000` gives https://<machine>.<tailnet>.ts.net:8444). Writes
# may come from them as from BETTER_AUTH_URL, which stays the sign-in origin and
# must be a loopback one: a phone cannot sign in with ChatGPT, so it is paired
# from settings with a QR code, which exists only while this is set.
# scripts/dev.sh hands this line to `next dev` too, which otherwise refuses the host.
# REMOTE_ORIGINS=
# The embedding models the API runs for everything it searches by meaning, and
# where their weights are: `pnpm --filter @shizue/api embedder:fetch` puts them
# there (bge-m3 from Hugging Face, KURE-v1 from the S3 bucket above); the server
# only reads them.
# EMBEDDER_ROUTING picks a plot's model: single (the default: EMBEDDER_MODEL for
# every plot, KURE-v1 unless set — multiMiniLM is the light one for development)
# or by-language (Korean plots KURE-v1, the rest bge-m3). EMBEDDER=off runs without
# one, and so without every search by meaning: the memory's similar summaries (recent
# and random ones take their share), the facts (none are extracted or sent), chat
# retrieval, explore's search by meaning (the text search answers) and the embedding
# emotion picker (the auxiliary model picks).
# EMBEDDER_THREADS caps each model's onnxruntime threads (default: every core).
# EMBEDDER_ROUTING=single
# EMBEDDER_MODEL=KURE-v1
# EMBEDDER_CACHE_DIR=./data/embedder
# EMBEDDER_THREADS=4
# EMBEDDER=off
# Several API instances can share one embedder instead of each loading the model
# (about 2 GB, up to 3.9 GB while it embeds): run `pnpm --filter @shizue/api
# embedder:serve` (built: `node dist/embedderServe.js`) where the weights are, with
# EMBEDDER_PORT, and set EMBEDDER_URL on the instances to that address. Both sides
# read the same EMBEDDER_ROUTING and EMBEDDER_MODEL. The port is never under /api;
# off loopback (EMBEDDER_HOST) it needs EMBEDDER_TOKEN, the same on both sides. An
# API instance that sets EMBEDDER_PORT without EMBEDDER_URL serves its own model.
# EMBEDDER_URL=http://127.0.0.1:8790
# EMBEDDER_PORT=8790
# EMBEDDER_HOST=127.0.0.1
# EMBEDDER_TOKEN=
# Korean aliases for the lore of works in other languages, written by the
# creator's (or the reader's) auxiliary model after an import or an edit, so a
# Korean reader's turns still reach an English book's entries. off turns the
# pass and the aliases off: those books go back to their own keys.
# LORE_ALIASES=off
# Echo is available only to automated tests running the API with NODE_ENV=test.
